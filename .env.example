# Dolce Candele — Environment Variables
# Copy this file to .env.local and fill in your values.

# URL base para a API PHP.
# Em produção (cPanel): deixa em branco ou coloca o teu domínio.
# Em desenvolvimento local: deixa como /api (o Vite faz o proxy automático).
VITE_API_URL=/api

# Supabase (já não é necessário se usares MySQL/cPanel)
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
