<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do not touch the api directory!
  RewriteRule ^api/ - [L]

  # If requested resource is not a real file or directory, route to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
